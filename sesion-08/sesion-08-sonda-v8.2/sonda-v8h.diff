+    /** Los codigos que se entregan a los participantes. La app no acepta otros. */
+    val CODIGOS_PARTICIPANTES = (1..9).map { "U$it" }.toSet()
+
+    /**
+     * La clave que muestra el formulario de consentimiento solo a quien acepta
+     * participar. Sin ella no se puede pasar de la bienvenida.
+     */
+    const val CLAVE_CONSENTIMIENTO = "once"
+
+    /** "u 3", "U3 " -> "U3": sin espacios y en mayusculas. */
+    fun normalizarCodigo(texto: String) = texto.replace(" ", "").trim().uppercase()
+
+    fun codigoValido(texto: String) = normalizarCodigo(texto) in CODIGOS_PARTICIPANTES
+
+    fun claveValida(texto: String) = texto.trim().lowercase() == CLAVE_CONSENTIMIENTO
+
