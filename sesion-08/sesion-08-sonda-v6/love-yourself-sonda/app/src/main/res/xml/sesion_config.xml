<?xml version="1.0" encoding="utf-8"?>
<!--
  canRetrieveWindowContent: hace falta para saber cuanto ocupa la zona que se
  desliza (event.source) y, en esta version de estudio, para leer en Instagram
  los ids y algunos textos que dicen de donde viene un reel. No se leen imagenes.
  typeViewClicked: un toque (like, comentarios) quita la cuenta regresiva del aviso.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeViewScrolled|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagIncludeNotImportantViews"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="true"
    android:description="@string/servicio_desc" />
