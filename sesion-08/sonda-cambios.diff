+    // ---- PROBE2: sonda de diagnostico, no es parte de la intervencion ----
+
+    private var ultimaSondaMs = 0L
+
+    /** Vuelca el arbol de la ventana activa en Logcat (tag PROBE2), como mucho cada PROBE2_THROTTLE_MS. */
+    private fun sonda() {
+        val ahora = SystemClock.uptimeMillis()
+        if (ahora - ultimaSondaMs < PROBE2_THROTTLE_MS) return
+        ultimaSondaMs = ahora
+        val raiz = runCatching { rootInActiveWindow }.getOrNull() ?: return
+        volcar(raiz, 0)
+        Log.d(PROBE2_TAG, "----------------------------------------")
+    }
+
+    private fun volcar(nodo: AccessibilityNodeInfo, profundidad: Int) {
+        Log.d(
+            PROBE2_TAG,
+            "  ".repeat(profundidad) +
+                "${nodo.className} id=${nodo.viewIdResourceName} text=${nodo.text} desc=${nodo.contentDescription}"
+        )
+        for (i in 0 until nodo.childCount) {
+            val hijo = nodo.getChild(i) ?: continue
+            volcar(hijo, profundidad + 1)
+        }
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) {
+            @Suppress("DEPRECATION")
+            nodo.recycle()
+        }
+    }
+
